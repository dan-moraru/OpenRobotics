<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!-- Exit Confirm – dialog bg #5D5B54, title bar #706E65, QUIT dark-red, RETURN dark #32312D -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.openrobotics.controllers.ExitConfirmController"
      styleClass="dialog-root" prefWidth="380" spacing="0"
      stylesheets="@../css/theme.css">

    <HBox styleClass="dialog-title-bar" alignment="CENTER_LEFT" spacing="12">
        <Label text="%exit.confirmation.title" styleClass="dialog-title-label" />
    </HBox>

    <VBox styleClass="dialog-body" spacing="12">
        <Label text="%exit.confirmation.message"
               styleClass="dialog-body-label"
               wrapText="true" />
        <Label text="%exit.confirmation.unsavedWarning"
               styleClass="dialog-warning-label" />
    </VBox>

    <HBox styleClass="dialog-footer" spacing="12" alignment="CENTER">
        <Button text="%exit.confirmation.return" styleClass="btn-neutral" prefWidth="150" onAction="#onReturn" />
        <Button text="%exit.confirmation.quit" styleClass="btn-danger" prefWidth="150" onAction="#onQuit" />
    </HBox>
</VBox>
