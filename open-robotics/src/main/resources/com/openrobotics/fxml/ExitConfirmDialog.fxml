<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!-- Exit Confirm – dialog bg #5D5B54, title bar #706E65, QUIT dark-red, RETURN dark #32312D -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.openrobotics.controllers.ExitConfirmController"
      styleClass="dialog-root" prefWidth="340" spacing="0"
      stylesheets="@../css/theme.css">

    <HBox styleClass="dialog-title-bar" alignment="CENTER_LEFT" spacing="8">
        <Label text="⚙" style="-fx-font-size: 15px; -fx-text-fill: #C2BEAE;" />
        <Label text="ARE YOU SURE YOU WANT TO QUIT?"
               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #C2BEAE; -fx-wrap-text: true;" />
    </HBox>

    <VBox styleClass="dialog-body" spacing="8">
        <Label text="As of the current version, your data"
               style="-fx-font-size: 11px; -fx-text-fill: #C2BEAE;" />
        <Label text="will not be saved."
               style="-fx-font-size: 11px; -fx-text-fill: #E0B200;
                      -fx-font-weight: bold; -fx-underline: true;" />
    </VBox>

    <HBox styleClass="dialog-footer" spacing="8" alignment="CENTER_LEFT">
        <Button text="QUIT"   styleClass="button-danger"  prefWidth="140" onAction="#onYes" />
        <Button text="RETURN" prefWidth="140"
                style="-fx-background-color: #32312D; -fx-text-fill: #C2BEAE;
                       -fx-font-weight: bold; -fx-font-size: 11px; -fx-background-radius: 0;"
                onAction="#onNo" />
    </HBox>
</VBox>
