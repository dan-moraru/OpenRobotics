<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!--
  Object Description Dialog (Specialty Screen col 3, row 2)
  Object image placeholder top, description text, ADD (green #599068) / RETURN (dark)
-->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.openrobotics.controllers.ObjectDescController"
      styleClass="dialog-root" prefWidth="340" spacing="0"
      stylesheets="@../css/theme.css"
      style="-fx-background-color: #C2BEAE;">

    <HBox styleClass="dialog-title-bar" alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: #C2BEAE; -fx-padding: 10 12 10 12; -fx-border-width: 0 0 1 0; -fx-border-color: #8D8A7F;">
        <Label fx:id="objectNameLabel" text="Object Description"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1a1a18;" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="✕"
                style="-fx-background-color: transparent; -fx-text-fill: #8D8A7F;
                       -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 0 4 0 4;"
                onAction="#onClose" />
    </HBox>

    <!-- Object image placeholder -->
    <StackPane style="-fx-background-color: #C2BEAE; -fx-min-height: 140; -fx-padding: 16;"
               VBox.vgrow="SOMETIMES">
        <StackPane fx:id="objectImagePane"
                   style="-fx-background-color: #C2BEAE; -fx-border-color: #8D8A7F;
                          -fx-border-width: 1;"
                   maxWidth="100" maxHeight="100">
            <Label fx:id="objectIconLabel" text="?"
                   style="-fx-font-size: 48px; -fx-text-fill: #8D8A7F;" />
        </StackPane>
    </StackPane>

    <!-- Description body -->
    <VBox styleClass="dialog-body" spacing="8" VBox.vgrow="ALWAYS"
          style="-fx-background-color: #C2BEAE; -fx-padding: 12;">
        <Label fx:id="objectDescLabel"
               text="Select an object type to add to your simulation. Each object type has specific properties and behaviors."
               style="-fx-font-size: 11px; -fx-text-fill: #1a1a18; -fx-wrap-text: true;" />
    </VBox>

    <HBox styleClass="dialog-footer" spacing="12" alignment="CENTER"
          style="-fx-background-color: #C2BEAE; -fx-padding: 12; -fx-border-width: 1 0 0 0; -fx-border-color: #8D8A7F;">
        <Button text="ADD" styleClass="btn-success" prefWidth="150" onAction="#onAdd" />
        <Button text="CLOSE" styleClass="btn-neutral" prefWidth="150" onAction="#onClose" />
    </HBox>
</VBox>

