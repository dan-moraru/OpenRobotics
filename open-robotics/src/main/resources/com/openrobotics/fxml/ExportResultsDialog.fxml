<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.openrobotics.controllers.ExportResultsController"
      styleClass="dialog-root"
      prefWidth="380" spacing="0"
      stylesheets="@../css/theme.css">

    <HBox styleClass="dialog-title-bar" alignment="CENTER_LEFT" spacing="12">
        <Label text="EXPORT RESULTS" styleClass="dialog-title-label" />
    </HBox>

    <VBox styleClass="dialog-body" spacing="12">
        <Label text="Select export directory:" styleClass="dialog-body-label" />
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button text="↺" styleClass="button-reset" prefWidth="36"
                    onAction="#onResetDirectory">
                <tooltip><Tooltip text="Reset to default directory" /></tooltip>
            </Button>
            <ComboBox fx:id="directoryCombo" promptText="Select directory..."
                      HBox.hgrow="ALWAYS" maxWidth="Infinity" />
        </HBox>
        <Label fx:id="selectedDirLabel" text="No directory selected"
               styleClass="dialog-dim-label" />
        <Button text="Browse…" styleClass="dialog-browse-btn" onAction="#onBrowse" />
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="File name:" styleClass="dialog-field-label" />
            <TextField fx:id="fileNameField" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
        </HBox>
    </VBox>

    <HBox styleClass="dialog-footer" spacing="12" alignment="CENTER">
        <Button text="EXPORT" styleClass="button-confirm" prefWidth="150" onAction="#onExport" />
        <Button text="CANCEL" styleClass="btn-neutral" prefWidth="150" onAction="#onCancel" />
    </HBox>
</VBox>