<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!--
    Load Config Dialog  (Specialty Screens wireframe – bottom row, col 2)
    ─────────────────────────────────────────────────────────────────────
    Logo+title bar, "Select file (.txt, .json)" label,
    dropdown (↺ reset) + hint text,
       LOAD (teal) + CANCEL (dark) footer.
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.openrobotics.controllers.LoadConfigController"
      styleClass="dialog-root load-dialog-root"
      prefWidth="380" spacing="0"
      stylesheets="@../css/theme.css">

    <!-- Title bar -->
    <HBox styleClass="dialog-title-bar load-dialog-title" alignment="CENTER_LEFT" spacing="12">
        <Label text="LOAD CONFIGURATION" styleClass="dialog-title-label-dark" />
    </HBox>

    <!-- Body -->
    <VBox styleClass="dialog-body load-dialog-body" spacing="12">
        <Label text="Select configuration file (.txt, .json):"
               styleClass="dialog-body-label" />

        <!-- Dropdown row: ↺ reset + combo -->
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button accessibleText="Reset to default" text="↺" styleClass="button-reset"
                    prefWidth="36" onAction="#onResetToDefault">
                <tooltip>
                    <Tooltip text="Reset to default" />
                </tooltip>
            </Button>
            <ComboBox fx:id="configFileCombo"
                      promptText="Select file..."
                      HBox.hgrow="ALWAYS" maxWidth="Infinity" />
        </HBox>

        <!-- Hint below dropdown -->
        <Label fx:id="selectedPathLabel"
               text="No configuration file selected"
               styleClass="dialog-hint-label" />

        <!-- Browse button -->
        <Button text="Browse Files…"
                styleClass="dialog-browse-btn-dark"
                onAction="#onBrowse" />
    </VBox>

    <!-- Footer -->
    <HBox styleClass="dialog-footer load-dialog-footer" spacing="12" alignment="CENTER">
        <Button text="LOAD" styleClass="btn-primary" prefWidth="150" onAction="#onLoad" />
        <Button text="CANCEL" styleClass="btn-neutral" prefWidth="150" onAction="#onCancel" />
    </HBox>
</VBox>
