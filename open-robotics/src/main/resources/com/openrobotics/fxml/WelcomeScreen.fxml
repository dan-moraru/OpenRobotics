<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!--  Welcome Screen – #C2BEAE outer bg, centred dialog, click anywhere → Setup  -->
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.openrobotics.controllers.WelcomeController"
           fx:id="rootPane"
           onMouseClicked="#onAnyClick"
           styleClass="welcome-root"
           stylesheets="@../css/theme.css">

    <VBox styleClass="welcome-dialog"
          maxWidth="820" prefWidth="720"
          minWidth="500" alignment="TOP_LEFT" spacing="0">

        <!-- Title bar  #9F9D96 -->
        <HBox styleClass="welcome-title-bar" alignment="CENTER_LEFT" spacing="8">
            <Label text="⚙" style="-fx-font-size: 20px; -fx-text-fill: #5D5B54;" />
            <Label text="Open Robotics Sim  x.x"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a18;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="✕" style="-fx-text-fill: #8D8A7F; -fx-font-size: 12px; -fx-cursor: hand;" />
        </HBox>

        <!-- UPDATES heading -->
        <HBox styleClass="welcome-body" style="-fx-padding: 10 14 2 14;">
            <Label text="UPDATES:"
                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #5D5B54;" />
        </HBox>

        <!-- Scrollable changelog body -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: #C2BEAE; -fx-border-color: transparent;
                           -fx-min-height: 280px;">
            <VBox fx:id="changelogContent" spacing="10"
                  style="-fx-padding: 4 14 12 14; -fx-background-color: #C2BEAE;">

                <Label text="Sprint 3 Update (v0.3.0-Skeleton):"
                       style="-fx-font-size: 11px; -fx-font-weight: bold;
                              -fx-text-fill: #3D3C39; -fx-wrap-text: true;" />
                <Label text="This build introduces the complete UI skeleton with all four screens (Welcome, Setup, Simulation, Results) wired together via ScreenNavigator. The 2D viewport canvas, sidebar panels, playback controls, properties panel, and results dashboard are all scaffolded and ready for simulation engine integration in Sprint 4."
                       style="-fx-font-size: 11px; -fx-text-fill: #5D5B54; -fx-wrap-text: true;" />

                <Label text="Sprint 2 Update (v0.2.0-Design):"
                       style="-fx-font-size: 11px; -fx-font-weight: bold;
                              -fx-text-fill: #3D3C39; -fx-wrap-text: true;" />
                <Label text="Design document complete. Class structure, UML diagrams, and technical specifications finalised. Maven project structure established with JavaFX 21 FXML support and PostgreSQL 42.7.7 JDBC driver wired in."
                       style="-fx-font-size: 11px; -fx-text-fill: #5D5B54; -fx-wrap-text: true;" />

                <Label text="Sprint 1 Update (v0.1.0-Spec):"
                       style="-fx-font-size: 11px; -fx-font-weight: bold;
                              -fx-text-fill: #3D3C39; -fx-wrap-text: true;" />
                <Label text="Specification document submitted. Branding, colour palette, screen mockups, database schema, and API contracts defined. Project scheduled across 7 two-week sprints targeting April 14 final demo."
                       style="-fx-font-size: 11px; -fx-text-fill: #5D5B54; -fx-wrap-text: true;" />
            </VBox>
        </ScrollPane>

        <!-- Bottom strip: desc left + click hint right -->
        <HBox styleClass="welcome-body"
              style="-fx-padding: 8 14 8 14; -fx-background-color: #C2BEAE;
                     -fx-border-color: #8D8A7F; -fx-border-width: 1 0 0 0;"
              alignment="CENTER_LEFT" spacing="0">
            <Label text="OpenRobotics is a configurable warehouse simulation platform for studying multi-robot coordination algorithms and measuring performance metrics."
                   style="-fx-font-size: 10px; -fx-text-fill: #8D8A7F;
                          -fx-wrap-text: true; -fx-max-width: 380px;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="clickHintLabel" text="click anywhere to start"
                   styleClass="welcome-click-hint" />
        </HBox>
    </VBox>

</StackPane>

