<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!-- Welcome Screen: branded intro + release notes. Click anywhere to continue. -->
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.openrobotics.controllers.WelcomeController"
           fx:id="rootPane"
           styleClass="welcome-root"
           stylesheets="@../css/theme.css">

    <VBox styleClass="welcome-shell" maxWidth="980" prefWidth="920" spacing="14">
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
            <ImageView fitHeight="30" fitWidth="30" preserveRatio="true">
                <image>
                    <Image url="@../img/logo_color.png" backgroundLoading="true"/>
                </image>
            </ImageView>
            <VBox spacing="1">
                <Label text="OpenRobotics" styleClass="app-title" />
                <Label text="warehouse simulation platform" styleClass="version-label" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label text="v1.0.0" styleClass="version-label" />
        </HBox>

        <HBox styleClass="welcome-main" spacing="16" VBox.vgrow="ALWAYS">
            <VBox styleClass="welcome-hero-panel" spacing="14" HBox.hgrow="ALWAYS">
                <Label text="Build, simulate, and compare multi-robot warehouse behavior."
                       styleClass="welcome-hero-title" wrapText="true" />
                <Label text="OpenRobotics helps you configure realistic task flows, test navigation and coordination strategies, and inspect metrics from repeatable simulation runs."
                       styleClass="welcome-hero-copy" wrapText="true" />

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button text="START SETUP" styleClass="btn-primary" onAction="#onStartSetup" />
                </HBox>
            </VBox>

            <VBox styleClass="welcome-updates-panel" prefWidth="360" minWidth="320" maxWidth="380" spacing="8">
                <Label text="LATEST UPDATES" styleClass="welcome-section-title" />

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="welcome-updates-scroll">
                    <VBox fx:id="changelogContent" styleClass="welcome-updates-content" spacing="10">
                        <Label text="Sprint 3 Update (v0.3.0-Skeleton)" styleClass="welcome-update-title" />
                        <Label text="Complete UI skeleton delivered with all major screens wired through ScreenNavigator. Viewport, panels, playback controls, and results dashboard are prepared for simulation engine integration."
                               styleClass="welcome-update-copy" wrapText="true" />

                        <Label text="Sprint 2 Update (v0.2.0-Design)" styleClass="welcome-update-title" />
                        <Label text="Class design, UML, and technical specifications finalized. Maven project structure established with JavaFX 21 FXML support and PostgreSQL JDBC integration."
                               styleClass="welcome-update-copy" wrapText="true" />

                        <Label text="Sprint 1 Update (v0.1.0-Spec)" styleClass="welcome-update-title" />
                        <Label text="Specification baseline delivered: branding, color palette, screen mockups, database schema, API contracts, and sprint plan."
                               styleClass="welcome-update-copy" wrapText="true" />
                    </VBox>
                </ScrollPane>
            </VBox>
        </HBox>

        <HBox styleClass="welcome-footer" alignment="CENTER_LEFT" spacing="0">
            <Label text="Tip: object names appear in simulation output and reports, so naming objects early makes analysis easier."
                   styleClass="label-hint" wrapText="true" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Use START SETUP to continue" styleClass="welcome-footer-hint" />
        </HBox>
    </VBox>

</StackPane>
