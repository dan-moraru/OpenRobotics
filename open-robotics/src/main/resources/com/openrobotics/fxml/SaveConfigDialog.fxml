<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!--
    Save Config Dialog  (§4.2 – Specialty Screen 4)
    ─────────────────────────────────────────────────
    • Down-arrow shows cached directories + "Browse…" option
    • White ↺ = revert to default save directory
    • File name field
    • Save / Cancel at the bottom
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.openrobotics.controllers.SaveConfigController"
      styleClass="dialog-root"
      prefWidth="380" spacing="0"
      stylesheets="@../css/theme.css"
      style="-fx-background-color: #5D5B54;">

    <HBox styleClass="dialog-title-bar" alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: #9E9B8E; -fx-padding: 10 12 10 12;">
        <Label text="SAVE CONFIGURATION"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1a1a18;" />
    </HBox>

    <VBox styleClass="dialog-body" spacing="12"
          style="-fx-background-color: #5D5B54; -fx-padding: 16 12 16 12;">
        <Label text="Select save directory:"
               style="-fx-font-size: 11px; -fx-text-fill: #C2BEAE; -fx-font-weight: bold;" />
        <HBox spacing="8" alignment="CENTER_LEFT">
                     <Button accessibleText="Reset directory to default" text="↺" styleClass="button-reset"
                                   prefWidth="36" onAction="#onResetDirectory">
                            <tooltip>
                                   <Tooltip text="Reset directory to default" />
                            </tooltip>
                     </Button>
            <ComboBox fx:id="directoryCombo" promptText="Select directory..."
                      HBox.hgrow="ALWAYS" maxWidth="Infinity" />
        </HBox>
        <Label fx:id="selectedDirLabel" text="Directory status"
               style="-fx-font-size: 10px; -fx-text-fill: #C2BEAE; -fx-wrap-text: true;" />
        <Button text="Browse…"
                style="-fx-background-color: transparent; -fx-text-fill: #C2BEAE;
                       -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 2 0 2 0;
                       -fx-underline: true;"
                onAction="#onBrowse" />
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="File name:"
                   style="-fx-font-size: 11px; -fx-text-fill: #C2BEAE; -fx-min-width: 80px;" />
            <TextField fx:id="fileNameField" text="config"
                       HBox.hgrow="ALWAYS" maxWidth="Infinity" />
        </HBox>
    </VBox>

    <HBox styleClass="dialog-footer" spacing="12" alignment="CENTER"
          style="-fx-background-color: #5D5B54; -fx-padding: 12;">
        <Button text="SAVE" styleClass="btn-primary" prefWidth="150" onAction="#onSave" />
        <Button text="CANCEL" styleClass="btn-neutral" prefWidth="150" onAction="#onCancel" />
    </HBox>
</VBox>

