<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!--
    Save Config Dialog  (§4.2 – Specialty Screen 4)
    ─────────────────────────────────────────────────
    • Down-arrow shows cached directories + "Browse…" option
    • White ↺ = revert to default save directory
    • File name field
    • Save / Cancel at the bottom
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.openrobotics.controllers.SaveConfigController"
      styleClass="dialog-root"
      prefWidth="380" spacing="0"
      stylesheets="@../css/theme.css">

    <HBox styleClass="dialog-title-bar" alignment="CENTER_LEFT" spacing="12">
        <Label text="%dialog.title" styleClass="dialog-title-label" />
    </HBox>

    <VBox styleClass="dialog-body" spacing="12">
        <Label text="%dialog.selectDirectory"
               styleClass="dialog-body-label" />
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button accessibleText="%dialog.resetDirectoryAccessibleText" text="↺" styleClass="button-reset"
                    prefWidth="36" onAction="#onResetDirectory">
                <tooltip>
                    <Tooltip text="%dialog.resetTooltip" />
                </tooltip>
            </Button>
            <ComboBox fx:id="directoryCombo" accessibleText="%dialog.directoryComboAccessibleText"
                      promptText="%dialog.directoryPrompt"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity" />
        </HBox>
        <Label fx:id="selectedDirLabel"
               styleClass="dialog-dim-label" />
        <Button text="%dialog.browseButton"
                accessibleText="%dialog.browseAccessibleText"
                styleClass="dialog-browse-btn"
                onAction="#onBrowse" />
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="%dialog.fileNameLabel" styleClass="dialog-field-label" labelFor="$fileNameField" />
            <TextField fx:id="fileNameField" text="%dialog.defaultFileName"
                       accessibleHelp="%dialog.fileNameHelp"
                       HBox.hgrow="ALWAYS" maxWidth="Infinity" />
        </HBox>
    </VBox>

    <HBox styleClass="dialog-footer" spacing="12" alignment="CENTER">
        <Button text="%dialog.saveButton" styleClass="btn-primary" prefWidth="150" onAction="#onSave" />
        <Button text="%dialog.cancelButton" styleClass="btn-neutral" prefWidth="150" onAction="#onCancel" />
    </HBox>
</VBox>
