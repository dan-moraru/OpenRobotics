<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!--
    Save Config Dialog  (§4.2 – Specialty Screen 4)
    ─────────────────────────────────────────────────
    • Down-arrow shows cached directories + "Browse…" option
    • White ↺ = revert to default save directory
    • File name field
    • Save / Cancel at the bottom
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.openrobotics.controllers.SaveConfigController"
      styleClass="dialog-root"
      prefWidth="340" spacing="0"
      stylesheets="@../css/theme.css">

    <HBox styleClass="dialog-title-bar" alignment="CENTER_LEFT" spacing="8">
        <Label text="⚙" style="-fx-font-size: 15px; -fx-text-fill: #C2BEAE;" />
        <Label text="SAVE CONFIG FILE"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #C2BEAE;" />
    </HBox>

    <VBox styleClass="dialog-body" spacing="10">
        <Label text="Select directory"
               style="-fx-font-size: 11px; -fx-text-fill: #C2BEAE;" />
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Button text="↺" styleClass="button-reset" onAction="#onResetToDefault" />
            <ComboBox fx:id="directoryCombo" promptText="C:/"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity" />
        </HBox>
        <Label fx:id="directoryStatusLabel" text="invalid directory"
               style="-fx-font-size: 10px; -fx-text-fill: #8D8A7F; -fx-wrap-text: true;" />
        <Button text="Browse…"
                style="-fx-background-color: transparent; -fx-text-fill: #C2BEAE;
                       -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 1 0 1 0;
                       -fx-underline: true;"
                onAction="#onBrowse" />
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Label text="File name:"
                   style="-fx-font-size: 11px; -fx-text-fill: #C2BEAE; -fx-pref-width: 80px;" />
            <TextField fx:id="fileNameField" text="config"
                       HBox.hgrow="ALWAYS" maxWidth="Infinity" />
        </HBox>
    </VBox>

    <HBox styleClass="dialog-footer" spacing="8" alignment="CENTER_LEFT">
        <Button text="CONFIRM" styleClass="button-confirm" prefWidth="140" onAction="#onSave" />
        <Button text="RETURN" prefWidth="140"
                style="-fx-background-color: #32312D; -fx-text-fill: #C2BEAE;
                       -fx-font-weight: bold; -fx-font-size: 11px; -fx-background-radius: 0;"
                onAction="#onCancel" />
    </HBox>
</VBox>

