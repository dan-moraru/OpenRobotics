<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.openrobotics.controllers.SetupController"
            styleClass="outer-bg"
            stylesheets="@../css/theme.css">

    <top>
        <VBox spacing="0">
            <HBox styleClass="top-bar-sim" alignment="CENTER_LEFT" spacing="12">
                <ImageView fitHeight="28" fitWidth="28" preserveRatio="true">
                    <image>
                        <Image url="@../img/logo_black.png" backgroundLoading="true"/>
                    </image>
                </ImageView>
                <VBox spacing="1">
                    <Label text="OpenRobotics" styleClass="app-title"/>
                    <Label text="v1.0.0" styleClass="version-label"/>
                </VBox>
                <MenuBar useSystemMenuBar="false" styleClass="menu-bar-top">
                    <menus>
                        <Menu text="File">
                            <items>
                                <MenuItem text="Welcome Screen" onAction="#onMenuWelcome"/>
                                <MenuItem text="Exit" onAction="#onExit"/>
                            </items>
                        </Menu>
                        <Menu text="Help">
                            <items>
                                <MenuItem text="GitHub Page" onAction="#onMenuGithub"/>
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.22">

            <!-- ZONE 1 – Config sidebar & Saved Configs -->
            <SplitPane orientation="VERTICAL" minWidth="190" prefWidth="240" dividerPositions="0.65">

                <VBox spacing="0">
                    <!-- Spacer matching tab row height so sidebar starts at viewport level -->
                    <Region styleClass="setup-sidebar-spacer"/>
                    <ScrollPane fitToWidth="true" styleClass="sidebar-setup" VBox.vgrow="ALWAYS">
                        <VBox fx:id="configPanel" spacing="0" styleClass="outer-bg config-panel">

                            <!-- Map -->
                            <VBox styleClass="setup-prop-group">
                                <HBox styleClass="setup-prop-row-b" alignment="CENTER_LEFT" spacing="5">
                                    <Label text="Map" styleClass="prop-label-bold"/>
                                    <ComboBox fx:id="mapCombo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                    <Button text="↺" styleClass="button-reset" onAction="#onResetMap"/>
                                </HBox>
                                <Label text="Select a preset warehouse layout or generate a random one."
                                       styleClass="setup-param-hint" wrapText="true"/>
                            </VBox>

                            <!-- Map Seed (hidden unless random_map) -->
                            <HBox fx:id="mapSeedRow" styleClass="setup-prop-row-a" alignment="CENTER_LEFT" spacing="5">
                                <Label text="Map Seed" styleClass="prop-label-bold"/>
                                <TextField fx:id="randomSeedField" promptText="auto"
                                           HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button text="↺" styleClass="button-reset" onAction="#onResetRandomSeed"/>
                            </HBox>

                            <!-- Coordination Policy -->
                            <VBox styleClass="setup-prop-group">
                                <HBox styleClass="setup-prop-row-b" alignment="CENTER_LEFT" spacing="5">
                                    <Label text="Coordination Policy" styleClass="prop-label-bold"/>
                                    <ComboBox fx:id="policyCombo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                    <Button text="↺" styleClass="button-reset" onAction="#onResetPolicy"/>
                                </HBox>
                                <Label text="How robots avoid conflicts. NONE = no coordination, TRAFFIC_RULES = intersection rules, RESERVATION_K = path reservation."
                                       styleClass="setup-param-hint" wrapText="true"/>
                            </VBox>

                            <!-- Reservation K -->
                            <VBox styleClass="setup-prop-group">
                                <HBox styleClass="setup-prop-row-a" alignment="CENTER_LEFT" spacing="5">
                                    <Label text="Reservation K" styleClass="prop-label-bold"/>
                                    <Spinner fx:id="reservationKSpinner"
                                             editable="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                    <Button text="↺" styleClass="button-reset" onAction="#onResetReservationK"/>
                                </HBox>
                                <Label text="Number of ticks ahead each robot reserves its path. Only active with RESERVATION_K policy."
                                       styleClass="setup-param-hint" wrapText="true"/>
                            </VBox>

                            <!-- Max Tasks -->
                            <VBox styleClass="setup-prop-group">
                                <HBox styleClass="setup-prop-row-b" alignment="CENTER_LEFT" spacing="5">
                                    <Label text="Number of Tasks" styleClass="prop-label-bold"/>
                                    <TextField fx:id="maxTasksField" text="10"
                                               HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                        <tooltip>
                                            <Tooltip text="Number of tasks randomly generated when the simulation starts. Racks that use Manual Dropoff Assignment override this for their own boxes."/>
                                        </tooltip>
                                    </TextField>
                                    <Button text="↺" styleClass="button-reset" onAction="#onResetMaxTasks"/>
                                </HBox>
                                <Label text="Total number of pickup-to-dropoff tasks generated for the run."
                                       styleClass="setup-param-hint" wrapText="true"/>
                            </VBox>

                            <!-- Workload Seed -->
                            <VBox styleClass="setup-prop-group">
                                <HBox styleClass="setup-prop-row-a" alignment="CENTER_LEFT" spacing="5">
                                    <Label text="Workload Seed" styleClass="prop-label-bold"/>
                                    <TextField fx:id="workloadSeedField" text="42"
                                               HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                    <Button text="↺" styleClass="button-reset" onAction="#onResetWorkloadSeed"/>
                                </HBox>
                                <Label text="Random seed for task generation. Same seed always produces the same task set."
                                       styleClass="setup-param-hint" wrapText="true"/>
                            </VBox>

                            <!-- Max Ticks -->
                            <VBox styleClass="setup-prop-group">
                                <HBox styleClass="setup-prop-row-b" alignment="CENTER_LEFT" spacing="5">
                                    <Label text="Max Ticks" styleClass="prop-label-bold"/>
                                    <TextField fx:id="maxTicksField" text="30000"
                                               HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                    <Button text="↺" styleClass="button-reset" onAction="#onResetMaxTicks"/>
                                </HBox>
                                <Label text="Simulation stops automatically after this many ticks."
                                       styleClass="setup-param-hint" wrapText="true"/>
                            </VBox>

                            <!-- Run Name -->
                            <VBox styleClass="setup-prop-group">
                                <HBox styleClass="setup-prop-row-a" alignment="CENTER_LEFT" spacing="5">
                                    <Label text="Run Name" styleClass="prop-label-bold"/>
                                    <TextField fx:id="runNameField" text="experiment_1"
                                               HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                    <Button text="↺" styleClass="button-reset" onAction="#onResetRunName"/>
                                </HBox>
                                <Label text="Label for this run, used in results and database records."
                                       styleClass="setup-param-hint" wrapText="true"/>
                            </VBox>

                            <!-- Canvas Size -->
                            <VBox styleClass="setup-prop-group">
                                <HBox styleClass="setup-prop-row-b" alignment="CENTER_LEFT" spacing="5">
                                    <Label text="Canvas Size" styleClass="prop-label-bold"/>
                                    <Spinner fx:id="canvasWidthSpinner" editable="true" prefWidth="54"/>
                                    <Label text="×" styleClass="canvas-size-separator"/>
                                    <Spinner fx:id="canvasHeightSpinner" editable="true" prefWidth="54"/>
                                    <Button text="↺" styleClass="button-reset" onAction="#onResetCanvasTiles"/>
                                </HBox>
                                <Label text="Width × Height of the simulation grid in tiles."
                                       styleClass="setup-param-hint" wrapText="true"/>
                            </VBox>

                            <!-- Canvas warning -->
                            <Label fx:id="canvasWarnLabel" styleClass="setup-warn-label"
                                   wrapText="true" visible="false" managed="false"/>

                        </VBox>
                    </ScrollPane>
                </VBox>

                <!-- Saved Configs -->
                <VBox spacing="0" styleClass="outer-bg">
                    <HBox styleClass="setup-configs-header" alignment="CENTER_LEFT" spacing="8">
                        <Label text="Saved Configurations" styleClass="setup-configs-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="↻" styleClass="button-reset" onAction="#onRefreshFileList"/>
                    </HBox>
                    <ListView fx:id="configListView" styleClass="setup-configs-list" VBox.vgrow="ALWAYS"/>
                </VBox>

            </SplitPane>

            <!-- ZONE 2 – 2D Preview Viewport -->
            <BorderPane styleClass="viewport-preview">
                <top>
                    <VBox spacing="0">
                        <HBox styleClass="setup-tab-row" alignment="CENTER_LEFT">
                            <Button text="EDITOR" styleClass="tab-btn-active" onAction="#onTabEditor"/>
                        </HBox>
                        <HBox styleClass="viewport-header" alignment="CENTER_LEFT" spacing="8">
                            <Label text="2D Viewport" styleClass="viewport-title-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Preview" styleClass="viewport-subtle-label"/>
                        </HBox>
                    </VBox>
                </top>
                <center>
                    <StackPane fx:id="viewportPreviewStack" styleClass="viewport-preview">
                        <Canvas fx:id="previewCanvas" managed="false"/>
                    </StackPane>
                </center>
            </BorderPane>

        </SplitPane>
    </center>

    <!-- ZONE 3 – Bottom bar -->
    <bottom>
        <HBox styleClass="setup-bottom-bar" alignment="CENTER_RIGHT" spacing="8">
            <Label fx:id="statusLabel" styleClass="setup-status-label" text=""/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="LOAD" styleClass="button-neutral" onAction="#onLoadConfig"/>
            <Button fx:id="setupNextButton" text="NEXT  &#x2192;" styleClass="button-green"
                    onAction="#onStartSimulation"/>
        </HBox>
    </bottom>

</BorderPane>