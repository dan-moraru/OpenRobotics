<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!--
  Results Screen — matches "1440p Desktop - RESULTS.png" Figma design.
  Topbar      #3D3C39   (reused via .top-bar-sim)
  Tab strip   #C2BEAE   EDITOR (inactive) | RESULTS (active)
  Chart area  #C2BEAE   two paginated line charts side-by-side
  Table area  #C2BEAE   alternating-row TableView
  Bottom bar  #32312D   display settings + optimisation summary
  Right panel #CDCBC3   2D mask viewport + legend + mask settings
-->

<BorderPane prefHeight="900" prefWidth="1440" style="-fx-background-color: #C2BEAE;" stylesheets="@../css/theme.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.openrobotics.controllers.ResultsController">

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- TOP: app bar + tab strip                                  -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <top>
        <VBox spacing="0">

            <!-- App title bar -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-bar-sim">
                <ImageView fitHeight="28" fitWidth="28" preserveRatio="true">
                    <image>
                        <Image backgroundLoading="true" url="@../img/logo_color.png" />
                    </image>
                </ImageView>
                <VBox spacing="1">
                    <Label styleClass="app-title" text="OpenRobotics" />
                    <Label styleClass="version-label" text="v1.0.0" />
                </VBox>
                <Region minWidth="24" />
                <MenuBar styleClass="menu-bar menu-bar-top">
                    <Menu text="File">
                        <MenuItem onAction="#onMenuWelcome" text="Welcome Screen" />
                        <MenuItem onAction="#onExit" text="Exit" />
                    </Menu>
                    <Menu text="Help">
                        <MenuItem onAction="#onMenuGithub" text="GitHub Page" />
                    </Menu>
                </MenuBar>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="ramLabel" style="-fx-text-fill: #C2BEAE; -fx-font-size: 11px;" text="ram: – kb" />
            </HBox>

        </VBox>
    </top>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- CENTRE: viewport-header (with nav buttons) + SplitPane   -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <center>
        <VBox spacing="0">

            <!-- Viewport-style header bar — mirrors SimulationScreen exactly -->
            <BorderPane styleClass="viewport-header">
                <left>
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label styleClass="viewport-icon-label" text="⊞" />
                        <Label styleClass="viewport-title-label" text="Results" />
                    </HBox>
                </left>
                <right>
                    <HBox alignment="CENTER_RIGHT" spacing="4" style="-fx-padding: 0 4 0 0;">
                        <Button onAction="#onTabEditor" styleClass="screen-tab-inactive" text="EDITOR" />
                        <Button onAction="#onTabResults" styleClass="screen-tab-active" text="RESULTS" />
                    </HBox>
                </right>
            </BorderPane>

        <SplitPane dividerPositions="0.58" style="-fx-background-color: #C2BEAE; -fx-padding: 0; -fx-box-border: transparent;" VBox.vgrow="ALWAYS">

            <!-- ─────────────────────────────────────────────── -->
            <!-- LEFT+CENTRE column                             -->
            <!-- ─────────────────────────────────────────────── -->
            <VBox spacing="0" style="-fx-background-color: #C2BEAE;">

                <!-- ╔══════════════ TWO CHARTS ══════════════╗ -->
                <HBox spacing="0" style="-fx-pref-height: 290px; -fx-min-height: 220px;                              -fx-border-color: #8D8A7F; -fx-border-width: 0 0 1 0;" VBox.vgrow="SOMETIMES">

                    <!-- Chart 1 ─────────────────────────── -->
                    <VBox spacing="0" style="-fx-border-color: #8D8A7F; -fx-border-width: 0 1 0 0;" HBox.hgrow="ALWAYS">

                        <!-- Chart 1 header -->
                        <HBox alignment="CENTER_LEFT" spacing="6" styleClass="chart-header">
                            <Label style="-fx-font-size: 10px; -fx-text-fill: #5D5B54;" text="axis_title" />
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="graph title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#onPrevChart" styleClass="playback-btn" text="◀" />
                            <Button onAction="#onNextChart" styleClass="playback-btn" text="▶" />
                            <Label fx:id="chartPageLabel" style="-fx-font-size: 10px;" text="1/10" />
                        </HBox>

                        <!-- Chart 1 body -->
                        <StackPane fx:id="chartContainer1" style="-fx-background-color: #C2BEAE;" VBox.vgrow="ALWAYS">
                            <LineChart animated="false" createSymbols="false" legendVisible="false" styleClass="results-chart">
                                <xAxis>
                                    <NumberAxis label="axis_title" lowerBound="0" side="BOTTOM" tickUnit="1" upperBound="3" />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="axis_title" lowerBound="0" side="LEFT" tickUnit="100" upperBound="400" />
                                </yAxis>
                            </LineChart>
                            <!-- Legend overlay (top-right) -->
                            <VBox alignment="TOP_RIGHT" mouseTransparent="true" spacing="3" style="-fx-padding: 8 12 0 0;                                          -fx-background-color: transparent;" StackPane.alignment="TOP_RIGHT">
                                <Label style="-fx-font-size: 9px; -fx-text-fill: #5D5B54;" text="legend" />
                                <HBox alignment="CENTER_LEFT" spacing="4">
                                    <Pane style="-fx-background-color: #AA3333;                                                  -fx-min-width: 14px; -fx-max-width: 14px;                                                  -fx-min-height: 14px; -fx-max-height: 14px;" />
                                    <Label style="-fx-font-size: 9px; -fx-text-fill: #5D5B54;" text="label" />
                                </HBox>
                            </VBox>
                        </StackPane>
                    </VBox>

                    <!-- Chart 2 ─────────────────────────── -->
                    <VBox spacing="0" HBox.hgrow="ALWAYS">

                        <!-- Chart 2 header -->
                        <HBox alignment="CENTER_LEFT" spacing="6" styleClass="chart-header">
                            <Label style="-fx-font-size: 10px; -fx-text-fill: #5D5B54;" text="axis_title" />
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="graph title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#onPrevChart2" styleClass="playback-btn" text="◀" />
                            <Button onAction="#onNextChart2" styleClass="playback-btn" text="▶" />
                            <Label fx:id="chartPage2Label" style="-fx-font-size: 10px;" text="2/10" />
                        </HBox>

                        <!-- Chart 2 body -->
                        <StackPane fx:id="chartContainer2" style="-fx-background-color: #C2BEAE;" VBox.vgrow="ALWAYS">
                            <LineChart animated="false" createSymbols="false" legendVisible="false" styleClass="results-chart">
                                <xAxis>
                                    <NumberAxis label="axis_title" lowerBound="0" side="BOTTOM" tickUnit="1" upperBound="3" />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="axis_title" lowerBound="0" side="LEFT" tickUnit="100" upperBound="400" />
                                </yAxis>
                            </LineChart>
                            <!-- Legend overlay (top-right) -->
                            <VBox alignment="TOP_RIGHT" mouseTransparent="true" spacing="3" style="-fx-padding: 8 12 0 0;                                          -fx-background-color: transparent;" StackPane.alignment="TOP_RIGHT">
                                <Label style="-fx-font-size: 9px; -fx-text-fill: #5D5B54;" text="legend" />
                                <HBox alignment="CENTER_LEFT" spacing="4">
                                    <Pane style="-fx-background-color: #AA3333;                                                  -fx-min-width: 14px; -fx-max-width: 14px;                                                  -fx-min-height: 14px; -fx-max-height: 14px;" />
                                    <Label style="-fx-font-size: 9px; -fx-text-fill: #5D5B54;" text="label" />
                                </HBox>
                            </VBox>
                        </StackPane>
                    </VBox>
                </HBox>
                <!-- ╚══════════════ /TWO CHARTS ═════════════╝ -->

                <!-- ╔════════════ TABLE SECTION ═════════════╗ -->

                <!-- Table title / info / pagination bar -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="chart-header">
                    <Label fx:id="tableTitle" style="-fx-font-weight: bold; -fx-font-size: 11px;" text="TABLE TITLE" />
                    <Label fx:id="tableInfoLabel" style="-fx-font-size: 10px; -fx-text-fill: #5D5B54;" text="rows: 200   columns: 2" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#onPrevTable" styleClass="playback-btn" text="◀" />
                    <Button onAction="#onNextTable" styleClass="playback-btn" text="▶" />
                    <Label fx:id="tablePageLabel" style="-fx-font-size: 10px;" text="1/6" />
                </HBox>

                <!-- Data table (rows alternate via CSS .table-row-cell:odd) -->
                <TableView fx:id="robotStatsTable" style="-fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colRobotId" prefWidth="75" text="Robot ID" />
                        <TableColumn fx:id="colNavAlgo" prefWidth="85" text="Algorithm" />
                        <TableColumn fx:id="colTasksDone" prefWidth="60" text="Tasks" />
                        <TableColumn fx:id="colDistance" prefWidth="72" text="Distance" />
                        <TableColumn fx:id="colEnergy" prefWidth="72" text="Energy" />
                        <TableColumn fx:id="colIdleTicks" prefWidth="68" text="Idle Tks" />
                        <TableColumn fx:id="colWaitTicks" prefWidth="68" text="Wait Tks" />
                        <TableColumn fx:id="colRobotCollisions" prefWidth="50" text="Coll." />
                        <TableColumn fx:id="colDeadlocks" prefWidth="44" text="DLs" />
                    </columns>
                </TableView>
                <!-- ╚════════════ /TABLE SECTION ════════════╝ -->

                <!-- ╔══════════ BOTTOM DARK PANEL ═══════════╗ -->
                <HBox alignment="TOP_LEFT" spacing="24" styleClass="results-bottom-panel">

                    <!-- Display settings column -->
                    <VBox minWidth="210" spacing="6">
                        <Label styleClass="results-section-title" text="RESULTS DISPLAY SETTINGS" />

                        <!-- columns spinner row -->
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label style="-fx-pref-width: 80px; -fx-font-size: 11px;                                           -fx-text-fill: #8D8A7F;" text="columns:" />
                            <Spinner fx:id="columnCountSpinner" editable="true" prefWidth="55">
                                <valueFactory>
                                    <SpinnerValueFactory.IntegerSpinnerValueFactory initialValue="2" max="10" min="1" />
                                </valueFactory>
                            </Spinner>
                        </HBox>

                        <!-- axis_setting row -->
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Button onAction="#onResetShowAllRobots" styleClass="button-reset" text="↺" />
                            <Label style="-fx-pref-width: 90px; -fx-font-size: 11px;                                           -fx-text-fill: #8D8A7F;" text="axis_setting" />
                            <Pane styleClass="results-setting-swatch" />
                            <CheckBox fx:id="showAllRobotsCheck" selected="true" />
                        </HBox>

                        <!-- data_setting rows -->
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Button onAction="#onResetShowEnergy" styleClass="button-reset" text="↺" />
                            <Label style="-fx-pref-width: 90px; -fx-font-size: 11px;                                           -fx-text-fill: #8D8A7F;" text="data_setting_1" />
                            <Pane styleClass="results-setting-swatch" />
                            <CheckBox fx:id="showEnergyCheck" selected="true" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Button onAction="#onResetShowCollisions" styleClass="button-reset" text="↺" />
                            <Label style="-fx-pref-width: 90px; -fx-font-size: 11px;                                           -fx-text-fill: #8D8A7F;" text="data_setting_2" />
                            <Pane styleClass="results-setting-swatch" />
                            <CheckBox fx:id="showCollisionsCheck" selected="true" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Button onAction="#onResetShowDeadlocks" styleClass="button-reset" text="↺" />
                            <Label style="-fx-pref-width: 90px; -fx-font-size: 11px;                                           -fx-text-fill: #8D8A7F;" text="data_setting_3" />
                            <Pane styleClass="results-setting-swatch" />
                            <CheckBox fx:id="showDeadlocksCheck" selected="true" />
                        </HBox>
                    </VBox>

                    <!-- Optimisation summary: 3 equal-width columns -->
                    <HBox alignment="TOP_LEFT" spacing="28" HBox.hgrow="ALWAYS">
                        <VBox fx:id="optSummaryCol1" spacing="3">
                            <Label styleClass="results-section-title" text="OPTIMIZATION SUMMARY" />
                            <Label styleClass="results-opt-label" text="stat1: ______" />
                            <Label styleClass="results-opt-label" text="stat2: ______" />
                            <Label styleClass="results-opt-label" text="stat3: ______" />
                            <Label styleClass="results-opt-label" text="stat4: ______" />
                            <Label styleClass="results-opt-label" text="stat5: ______" />
                            <Label styleClass="results-opt-label" text="stat6: ______" />
                            <Label styleClass="results-opt-label" text="stat7: ______" />
                        </VBox>
                        <VBox fx:id="optSummaryCol2" spacing="3">
                            <Label style="-fx-font-size: 10px;" text=" " />
                            <Label styleClass="results-opt-label" text="stat1: ______" />
                            <Label styleClass="results-opt-label" text="stat2: ______" />
                            <Label styleClass="results-opt-label" text="stat3: ______" />
                            <Label styleClass="results-opt-label" text="stat4: ______" />
                            <Label styleClass="results-opt-label" text="stat5: ______" />
                            <Label styleClass="results-opt-label" text="stat6: ______" />
                            <Label styleClass="results-opt-label" text="stat7: ______" />
                        </VBox>
                        <VBox fx:id="optSummaryCol3" spacing="3">
                            <Label style="-fx-font-size: 10px;" text=" " />
                            <Label styleClass="results-opt-label" text="stat1: ______" />
                            <Label styleClass="results-opt-label" text="stat2: ______" />
                            <Label styleClass="results-opt-label" text="stat3: ______" />
                            <Label styleClass="results-opt-label" text="stat4: ______" />
                            <Label styleClass="results-opt-label" text="stat5: ______" />
                            <Label styleClass="results-opt-label" text="stat6: ______" />
                            <Label styleClass="results-opt-label" text="stat7: ______" />
                        </VBox>
                    </HBox>

                </HBox>
                <!-- ╚══════════ /BOTTOM DARK PANEL ═══════════╝ -->

                <!-- NEW SIMULATION / VIEW HISTORY -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="results-actions-bar">
                    <Button onAction="#onNewExperiment" text="NEW SIMULATION" />
                    <Button onAction="#onViewHistory" styleClass="button-neutral" text="VIEW HISTORY" />
                </HBox>

            </VBox>
            <!-- ─────────────── /LEFT COLUMN ─────────────── -->

            <!-- ─────────────────────────────────────────────── -->
            <!-- RIGHT column: 2D Mask Viewport                  -->
            <!-- ─────────────────────────────────────────────── -->
            <VBox spacing="0" style="-fx-background-color: #C2BEAE; -fx-min-width: 300px;">

                <!-- Viewport header bar -->
                <HBox alignment="CENTER_LEFT" spacing="5" styleClass="viewport-header">
                    <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="2D Mask Viewport" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#onMaskZoomIn" styleClass="playback-btn" text="+" />
                    <Button onAction="#onMaskZoomOut" styleClass="playback-btn" text="−" />
                    <Button onAction="#onPrevMask" styleClass="playback-btn" text="◀" />
                    <Button onAction="#onNextMask" styleClass="playback-btn" text="▶" />
                    <Label fx:id="maskPageLabel" style="-fx-font-size: 10px;" text="1/3" />
                </HBox>

                <!-- Mask canvas (#CDCBC3 grid area) -->
                <StackPane fx:id="heatmapContainer" style="-fx-background-color: #CDCBC3;" VBox.vgrow="ALWAYS">
                    <Canvas fx:id="heatmapCanvas" />
                    <Label style="-fx-font-size: 13px; -fx-font-weight: bold;                                   -fx-text-fill: #8D8A7F;" text="MASKS ON VIEWPORT" />
                </StackPane>

                <!-- Mask colour legend -->
                <VBox spacing="5" style="-fx-background-color: #CDCBC3; -fx-padding: 10 12 10 12;                              -fx-border-color: #8D8A7F; -fx-border-width: 1 0 0 0;">
                    <Label fx:id="maskTitleLabel" style="-fx-font-size: 11px; -fx-font-weight: bold;                                   -fx-text-fill: #1a1a18;" text="Title of mask" />
                    <Label fx:id="maskSubtitleLabel" style="-fx-font-size: 10px; -fx-text-fill: #5D5B54;" text="x: something" />
                    <!-- Colour bar tiles -->
                    <HBox spacing="3">
                        <Pane prefHeight="14" prefWidth="70" styleClass="mask-legend-tile-red" />
                        <Pane prefHeight="14" prefWidth="70" styleClass="mask-legend-tile-yellow" />
                        <Pane prefHeight="14" prefWidth="70" styleClass="mask-legend-tile-grey" />
                    </HBox>
                    <!-- Legend labels -->
                    <HBox spacing="3">
                        <Label style="-fx-font-size: 9px; -fx-text-fill: #5D5B54;                                       -fx-pref-width: 70px; -fx-wrap-text: true;" text="≥ higher than 30" />
                        <Label style="-fx-font-size: 9px; -fx-text-fill: #5D5B54;                                       -fx-pref-width: 70px; -fx-wrap-text: true;" text="&gt; higher than 15, ≤ lower than 30" />
                        <Label style="-fx-font-size: 9px; -fx-text-fill: #5D5B54;                                       -fx-pref-width: 70px; -fx-wrap-text: true;" text="≤ lower than 15" />
                    </HBox>
                </VBox>

                <!-- Mask settings panel -->
                <VBox spacing="5" style="-fx-background-color: #C2BEAE; -fx-padding: 10 12 10 12;                              -fx-border-color: #8D8A7F; -fx-border-width: 1 0 0 0;">
                    <Label style="-fx-font-size: 11px; -fx-font-weight: bold;                                   -fx-text-fill: #1a1a18;" text="Mask Settings" />
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label style="-fx-pref-width: 100px; -fx-font-size: 11px;" text="View objects" />
                        <CheckBox fx:id="viewObjectsCheck" onAction="#onToggleViewObjects" selected="true" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label style="-fx-pref-width: 100px; -fx-font-size: 11px;" text="Something" />
                        <CheckBox fx:id="maskOpt1Check" selected="true" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label style="-fx-pref-width: 100px; -fx-font-size: 11px;" text="Something" />
                        <CheckBox fx:id="maskOpt2Check" selected="true" />
                    </HBox>
                </VBox>

                <!-- Export action bar -->
                <HBox alignment="CENTER_RIGHT" styleClass="results-actions-bar">
                    <Button onAction="#onExport" styleClass="button-green" text="⬇  EXPORT PACKAGE" />
                </HBox>

            </VBox>
            <!-- ─────────────── /RIGHT COLUMN ─────────────── -->

        </SplitPane>

        </VBox>
    </center>

</BorderPane>
