<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!--
  Results Screen — post-simulation dashboard.
  Topbar      #C2BEAE   (shared with SimulationScreen)
  Tab strip   #C2BEAE   EDITOR (inactive) | RESULTS (active)
  Chart area  #C2BEAE   two charts side-by-side
  Table area  #C2BEAE   robot stats TableView
  Summary     #32312D   dark panel with computed stats
  Right panel #CDCBC3   2D heatmap viewport
-->

<BorderPane prefHeight="900" prefWidth="1440" styleClass="outer-bg"
            stylesheets="@../css/theme.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.openrobotics.controllers.ResultsController">

    <top>
        <VBox spacing="0">

            <!-- App title bar (same as SimulationScreen) -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-bar-sim">
                <ImageView fitHeight="28" fitWidth="28" preserveRatio="true">
                    <image><Image backgroundLoading="true" url="@../img/logo_black.png" /></image>
                </ImageView>
                <VBox spacing="1">
                    <Label styleClass="app-title" text="OpenRobotics" />
                    <Label styleClass="version-label" text="v1.0.0" />
                </VBox>
                <Region minWidth="24" />
                <MenuBar styleClass="menu-bar menu-bar-top">
                    <Menu text="File">
                        <MenuItem onAction="#onMenuWelcome" text="Welcome Screen" />
                        <MenuItem onAction="#onExport" text="Export Results" />
                        <MenuItem onAction="#onExit" text="Exit" />
                    </Menu>
                    <Menu text="Help">
                        <MenuItem onAction="#onMenuGithub" text="GitHub Page" />
                    </Menu>
                </MenuBar>
                <Region HBox.hgrow="ALWAYS" />
                <!-- Live stats (same style as SimulationScreen) -->
                <Label fx:id="simTicksLabel" styleClass="sim-stat-label" text="Ticks: 0" />
                <Region minWidth="12" />
                <Label fx:id="simStatusLabel" styleClass="sim-stat-label" text="Status: –" />
                <Region minWidth="12" />
                <Label fx:id="ramLabel" styleClass="sim-stat-label" text="RAM: – KB" />
            </HBox>

            <!-- Tab strip (same structure as SimulationScreen) -->
            <HBox alignment="CENTER_LEFT" styleClass="tab-strip sim-tab-strip">
                <Region minWidth="232.0" />
                <Button onAction="#onTabEditor" styleClass="tab-btn" text="EDITOR" />
                <Button onAction="#onTabResults" styleClass="tab-btn-active" text="RESULTS" />
            </HBox>

        </VBox>
    </top>

    <center>
        <VBox spacing="0">

            <!-- Viewport-style header bar -->
            <BorderPane styleClass="viewport-header">
                <left>
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label styleClass="viewport-icon-label" text="&#x229e;" />
                        <Label styleClass="chart-section-title" text="Simulation Results" />
                    </HBox>
                </left>
                <right>
                    <HBox alignment="CENTER_RIGHT" spacing="8">
                        <Label fx:id="runNameLabel" styleClass="run-name-label" text="" />
                    </HBox>
                </right>
            </BorderPane>

        <SplitPane dividerPositions="0.6" VBox.vgrow="ALWAYS">

            <!-- LEFT COLUMN: charts + table + summary -->
            <VBox spacing="0" styleClass="outer-bg">

                <!-- Two charts side-by-side -->
                <HBox spacing="0" styleClass="charts-row" VBox.vgrow="SOMETIMES">

                    <!-- Chart 1: Tasks Completed per Robot -->
                    <VBox spacing="0" styleClass="chart-col" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="6" styleClass="chart-header">
                            <Label styleClass="chart-section-title" text="Tasks Completed" />
                            <Region HBox.hgrow="ALWAYS" />
                        </HBox>
                        <StackPane fx:id="chartContainer1" styleClass="chart-container" VBox.vgrow="ALWAYS" />
                    </VBox>

                    <!-- Chart 2: Energy Consumed per Robot -->
                    <VBox spacing="0" styleClass="chart-col" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="6" styleClass="chart-header">
                            <Label styleClass="chart-section-title" text="Energy Consumed" />
                            <Region HBox.hgrow="ALWAYS" />
                        </HBox>
                        <StackPane fx:id="chartContainer2" styleClass="chart-container" VBox.vgrow="ALWAYS" />
                    </VBox>
                </HBox>

                <!-- Table header -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="chart-header">
                    <Label fx:id="tableTitle" styleClass="chart-section-title"
                           text="ROBOT PERFORMANCE" />
                    <Label fx:id="tableInfoLabel" styleClass="table-info-label" text="" />
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>

                <!-- Robot stats table -->
                <TableView fx:id="robotStatsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colRobotId" prefWidth="110" text="Robot" />
                        <TableColumn fx:id="colNavAlgo" prefWidth="85" text="Algorithm" />
                        <TableColumn fx:id="colTasksDone" prefWidth="60" text="Tasks" />
                        <TableColumn fx:id="colDistance" prefWidth="72" text="Distance" />
                        <TableColumn fx:id="colEnergy" prefWidth="80" text="Energy Used" />
                        <TableColumn fx:id="colIdleTicks" prefWidth="68" text="Idle Tks" />
                        <TableColumn fx:id="colWaitTicks" prefWidth="68" text="Stuck Tks" />
                        <TableColumn fx:id="colBattery" prefWidth="65" text="Battery" />
                        <TableColumn fx:id="colState" prefWidth="70" text="State" />
                    </columns>
                </TableView>

                <!-- Summary panel (dark) -->
                <HBox alignment="TOP_LEFT" spacing="24" styleClass="results-bottom-panel">

                    <!-- Simulation summary -->
                    <VBox minWidth="200" spacing="4">
                        <Label styleClass="results-section-title" text="SIMULATION SUMMARY" />
                        <Label fx:id="statTotalTicks" styleClass="results-opt-label" text="Total Ticks: –" />
                        <Label fx:id="statTotalTasks" styleClass="results-opt-label" text="Total Tasks: –" />
                        <Label fx:id="statCompletedTasks" styleClass="results-opt-label" text="Completed: –" />
                        <Label fx:id="statPendingTasks" styleClass="results-opt-label" text="Pending: –" />
                        <Label fx:id="statThroughput" styleClass="results-opt-label" text="Throughput: –" />
                        <Label fx:id="statCompletionRate" styleClass="results-opt-label" text="Completion: –" />
                    </VBox>

                    <!-- Robot averages -->
                    <VBox minWidth="200" spacing="4">
                        <Label styleClass="results-section-title" text="ROBOT AVERAGES" />
                        <Label fx:id="statAvgTasks" styleClass="results-opt-label" text="Avg Tasks/Robot: –" />
                        <Label fx:id="statAvgDistance" styleClass="results-opt-label" text="Avg Distance: –" />
                        <Label fx:id="statAvgEnergy" styleClass="results-opt-label" text="Avg Energy Used: –" />
                        <Label fx:id="statAvgIdlePct" styleClass="results-opt-label" text="Avg Idle %: –" />
                        <Label fx:id="statAvgStuckPct" styleClass="results-opt-label" text="Avg Stuck %: –" />
                        <Label fx:id="statAvgBattery" styleClass="results-opt-label" text="Avg Battery: –" />
                    </VBox>

                    <!-- Extremes -->
                    <VBox minWidth="200" spacing="4" HBox.hgrow="ALWAYS">
                        <Label styleClass="results-section-title" text="HIGHLIGHTS" />
                        <Label fx:id="statBestRobot" styleClass="results-opt-label" text="Most Tasks: –" />
                        <Label fx:id="statWorstRobot" styleClass="results-opt-label" text="Fewest Tasks: –" />
                        <Label fx:id="statMostDistance" styleClass="results-opt-label" text="Most Distance: –" />
                        <Label fx:id="statMostEnergy" styleClass="results-opt-label" text="Most Energy: –" />
                        <Label fx:id="statMostIdle" styleClass="results-opt-label" text="Most Idle: –" />
                        <Label fx:id="statTotalDistance" styleClass="results-opt-label" text="Total Distance: –" />
                    </VBox>

                </HBox>

                <!-- Bottom action bar -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="results-actions-bar">
                    <Button onAction="#onNewExperiment" text="NEW SIMULATION" />
                    <Button onAction="#onViewHistory" styleClass="button-neutral" text="RETURN TO EDITOR" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#onExport" styleClass="button-confirm" text="EXPORT RESULTS" />
                </HBox>

            </VBox>

            <!-- RIGHT COLUMN: Heatmap viewport -->
            <VBox spacing="0" styleClass="outer-bg" minWidth="280">

                <!-- Viewport header -->
                <HBox alignment="CENTER_LEFT" spacing="5" styleClass="viewport-header">
                    <Label styleClass="chart-section-title" text="2D Heatmap" />
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>

                <!-- Heatmap canvas -->
                <StackPane fx:id="heatmapContainer" styleClass="heatmap-container" VBox.vgrow="ALWAYS">
                    <Canvas fx:id="heatmapCanvas" />
                    <Label fx:id="heatmapPlaceholder" styleClass="viewport-overlay-label"
                           text="Run simulation to generate heatmap" />
                </StackPane>

                <!-- Heatmap legend -->
                <VBox spacing="5" styleClass="mask-legend-panel">
                    <Label fx:id="maskTitleLabel" styleClass="mask-panel-title" text="Visit Frequency" />
                    <Label fx:id="maskSubtitleLabel" styleClass="mask-panel-subtitle"
                           text="Tiles colored by robot visit count" />
                    <HBox spacing="3">
                        <Pane prefHeight="14" prefWidth="70" styleClass="mask-legend-tile-red" />
                        <Pane prefHeight="14" prefWidth="70" styleClass="mask-legend-tile-yellow" />
                        <Pane prefHeight="14" prefWidth="70" styleClass="mask-legend-tile-grey" />
                    </HBox>
                    <HBox spacing="3">
                        <Label styleClass="mask-legend-label" text="High traffic" />
                        <Label styleClass="mask-legend-label" text="Medium traffic" />
                        <Label styleClass="mask-legend-label" text="Low traffic" />
                    </HBox>
                </VBox>

                <!-- Heatmap settings -->
                <VBox spacing="5" styleClass="mask-settings-panel">
                    <Label styleClass="mask-panel-title" text="Overlay Settings" />
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label styleClass="overlay-setting-label" text="Show entities" />
                        <CheckBox fx:id="viewObjectsCheck" onAction="#onToggleViewObjects" selected="true" />
                    </HBox>
                </VBox>

                <!-- Export bar -->
                <HBox alignment="CENTER_RIGHT" styleClass="results-actions-bar">
                    <Button onAction="#onExport" styleClass="button-confirm" text="EXPORT RESULTS" />
                </HBox>

            </VBox>

        </SplitPane>

        </VBox>
    </center>

</BorderPane>
